{
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "hosting": [
    {
      "target": "brand",
      "public": "store-assets/web",
      "cleanUrls": true,
      "ignore": ["firebase.json", "**/.*"]
    },
    {
      "target": "legacy",
      "public": "store-assets/web-redirect",
      "cleanUrls": true,
      "redirects": [
        {
          "source": "/privacy",
          "destination": "https://lidhikri.web.app/privacy",
          "type": 301
        },
        {
          "source": "/privacy.html",
          "destination": "https://lidhikri.web.app/privacy",
          "type": 301
        },
        {
          "source": "**",
          "destination": "https://lidhikri.web.app",
          "type": 301
        }
      ]
    },
    {
      "target": "oldbrand",
      "public": "store-assets/web-redirect",
      "cleanUrls": true,
      "redirects": [
        {
          "source": "/privacy",
          "destination": "https://lidhikri.web.app/privacy",
          "type": 301
        },
        {
          "source": "/privacy.html",
          "destination": "https://lidhikri.web.app/privacy",
          "type": 301
        },
        {
          "source": "**",
          "destination": "https://lidhikri.web.app",
          "type": 301
        }
      ]
    }
  ]
}
