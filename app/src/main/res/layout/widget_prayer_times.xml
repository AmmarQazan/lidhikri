<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_prayer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_misbaha_background_cream"
    android:gravity="top|center_horizontal"
    android:layoutDirection="locale"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="4dp"
    android:paddingEnd="6dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/widget_prayer_city"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/prayer_widget_today_title"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/widget_prayer_viewport"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:clipChildren="true">

        <LinearLayout
            android:id="@+id/widget_prayer_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical">

        <LinearLayout
            android:id="@+id/widget_prayer_imsak"
            style="@style/WidgetPrayerRow">

            <TextView
                android:id="@+id/widget_prayer_imsak_name"
                style="@style/WidgetPrayerName"
                android:text="@string/prayer_name_imsak" />

            <TextView
                android:id="@+id/widget_prayer_imsak_time"
                style="@style/WidgetPrayerTime"
                android:text="--:--" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_prayer_fajr"
            style="@style/WidgetPrayerRow">

            <TextView
                android:id="@+id/widget_prayer_fajr_name"
                style="@style/WidgetPrayerName"
                android:text="@string/prayer_name_fajr" />

            <TextView
                android:id="@+id/widget_prayer_fajr_time"
                style="@style/WidgetPrayerTime"
                android:text="--:--" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_prayer_sunrise"
            style="@style/WidgetPrayerRow">

            <TextView
                android:id="@+id/widget_prayer_sunrise_name"
                style="@style/WidgetPrayerName"
                android:text="@string/prayer_name_sunrise" />

            <TextView
                android:id="@+id/widget_prayer_sunrise_time"
                style="@style/WidgetPrayerTime"
                android:text="--:--" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_prayer_dhuhr"
            style="@style/WidgetPrayerRow">

            <TextView
                android:id="@+id/widget_prayer_dhuhr_name"
                style="@style/WidgetPrayerName"
                android:text="@string/prayer_name_dhuhr" />

            <TextView
                android:id="@+id/widget_prayer_dhuhr_time"
                style="@style/WidgetPrayerTime"
                android:text="--:--" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_prayer_asr"
            style="@style/WidgetPrayerRow">

            <TextView
                android:id="@+id/widget_prayer_asr_name"
                style="@style/WidgetPrayerName"
                android:text="@string/prayer_name_asr" />

            <TextView
                android:id="@+id/widget_prayer_asr_time"
                style="@style/WidgetPrayerTime"
                android:text="--:--" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_prayer_maghrib"
            style="@style/WidgetPrayerRow">

            <TextView
                android:id="@+id/widget_prayer_maghrib_name"
                style="@style/WidgetPrayerName"
                android:text="@string/prayer_name_maghrib" />

            <TextView
                android:id="@+id/widget_prayer_maghrib_time"
                style="@style/WidgetPrayerTime"
                android:text="--:--" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_prayer_isha"
            style="@style/WidgetPrayerRow">

            <TextView
                android:id="@+id/widget_prayer_isha_name"
                style="@style/WidgetPrayerName"
                android:text="@string/prayer_name_isha" />

            <TextView
                android:id="@+id/widget_prayer_isha_time"
                style="@style/WidgetPrayerTime"
                android:text="--:--" />
        </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/widget_prayer_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/prayer_times_need_city"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
